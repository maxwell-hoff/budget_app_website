# Copy to .env for local development. Names only; never commit real values.

# Postgres in production (Render/Neon). Leave unset locally to use instance/app.db (SQLite).
DATABASE_URL=

# Required in production (the app refuses to start on Render without it). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Account, billing, and desktop sign-in features. Keep false in production until launch.
ACCOUNTS_ENABLED=false

# Transactional email (Resend). Without RESEND_API_KEY, emails are printed to the console.
RESEND_API_KEY=
# Optional. Must be an address on a domain verified in Resend.
# EMAIL_FROM=Workbench Budgeting <noreply@workbenchbudgeting.com>

# Sign in with Google (OAuth client of type "Web application" in Google Cloud Console).
# Redirect URI: http://127.0.0.1:5001/auth/google/callback locally,
# https://workbenchbudgeting.com/auth/google/callback in production.
# The Google button is hidden unless both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe billing (use test-mode values locally). Subscribing is hidden unless all three are set.
# STRIPE_SECRET_KEY: Developers > API keys (sk_test_...).
# STRIPE_PRICE_ID: the $8.99/month price on the product page (price_...).
# STRIPE_WEBHOOK_SECRET: locally, the whsec_... printed by
#   stripe listen --forward-to 127.0.0.1:5001/stripe/webhook
# in production, the signing secret of the webhook endpoint in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional. Base for links in emails and the Google redirect URI. Defaults to https://workbenchbudgeting.com on Render
# and to the request's host locally.
# PUBLIC_BASE_URL=

# Optional. Defaults to true on Render (RENDER=true) and false locally, so dev works over http.
# SESSION_COOKIE_SECURE=
