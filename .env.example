# Copy to .env for local development. Names only; never commit real values.

# Postgres in production (Render/Neon). Leave unset locally to use instance/app.db (SQLite).
DATABASE_URL=

# Required in production (the app refuses to start on Render without it). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Account, billing, and desktop sign-in features. Keep false in production until launch.
ACCOUNTS_ENABLED=false

# Transactional email (Resend). Without RESEND_API_KEY, emails are printed to the console.
RESEND_API_KEY=
# Optional. Must be an address on a domain verified in Resend.
# EMAIL_FROM=Workbench Budgeting <noreply@workbenchbudgeting.com>

# Optional. Base for links in emails. Defaults to https://workbenchbudgeting.com on Render
# and to the request's host locally.
# PUBLIC_BASE_URL=

# Optional. Defaults to true on Render (RENDER=true) and false locally, so dev works over http.
# SESSION_COOKIE_SECURE=
